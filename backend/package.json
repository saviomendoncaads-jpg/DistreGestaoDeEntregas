{
  "name": "distre-backend",
  "version": "1.0.0",
  "description": "Backend for Distre - Gestão de Entregas",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "node --watch --require ts-node/register src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "@xmldom/xmldom": "0.9.12",
    "bcryptjs": "^2.4.3",
    "bwip-js": "4.11.4",
    "cors": "^2.8.5",
    "distre": "file:..",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.2.0",
    "msnodesqlv8": "^5.2.0",
    "mssql": "^12.5.4",
    "node-forge": "^1.4.0",
    "pdfkit": "0.20.2",
    "qrcode": "^1.5.4",
    "redis": "^4.7.1",
    "socket.io": "^4.8.1",
    "xml-crypto": "6.3.3",
    "xmllint-wasm": "5.3.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.10.2",
    "@types/node-forge": "^1.3.14",
    "@types/pdfkit": "0.17.6",
    "@types/qrcode": "^1.5.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "msnodesqlv8@5.5.0": true
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
